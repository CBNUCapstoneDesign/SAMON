# /etc/samon/samon.conf — samon 설정 (install.sh가 없을 때만 이 파일을 복사한다)

[web]
# samon web의 기본 포트. 서버는 127.0.0.1에만 연결을 받는다.
port = 8765

# 사용자 정의 프리셋: [preset:이름] 아래에 "항목 = 값"을 적는다.
# 항목 이름과 범위는 samon 대화형 CLI의 h 키 또는 README.md에 있다.
# 감시(monitor) on은 다른 항목을 모두 쓴 뒤에 적용한다.
#
# [preset:write_only]
# monitor = on
# p1 = off
# p2 = off
# p3 = off
# p4 = on
# p5 = on
# hot_threshold = 20
