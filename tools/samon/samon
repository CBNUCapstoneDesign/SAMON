#!/usr/bin/env python3
"""samon — SAMON 제어 도구 진입점.

  sudo samon                  인자 없음: 대화형 CLI
  sudo samon web [--port N]   인자 있음: 웹 서버 (http://127.0.0.1:8765, 이 장비에서만 접속)
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))


def main() -> int:
    if len(sys.argv) == 1:
        from samon_cli import main as cli_main
        return cli_main()
    from samon_web import main as web_main
    return web_main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
